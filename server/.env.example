# بيانات Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# بيانات Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# سر توقيع الجلسات (JWT) — استخدم قيمة عشوائية طويلة، لا تستخدم هذا المثال
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# واتساب (Green API)
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN_INSTANCE=

# حساب الإدارة — كلمة المرور مُشفّرة (bcrypt) وليست نصاً عادياً
# لتوليد الهاش: node -e "console.log(require('bcryptjs').hashSync('كلمة_المرور', 10))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# نطاقات مسموح لها بالوصول عبر CORS (مفصولة بفواصل)
CORS_ORIGINS=

# منفذ الخادم
PORT=3000
